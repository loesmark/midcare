# ═══════════════════════════════════════════════════════════
#  MediCare Backend — Environment Variables (template)
#
#  • LOCAL DEV:  Copy this file to `.env` and edit the values.
#                `cp .env.example .env`
#
#  • RENDER:     DO NOT commit `.env`. Set these in the Render
#                dashboard → Environment → Add Environment Variable.
# ═══════════════════════════════════════════════════════════

# ── Turso (REQUIRED on Render) ──────────────────────────────
# Get them with:
#   turso db show medicare --url
#   turso db tokens create medicare
TURSO_DATABASE_URL=libsql://medicare-<your-username>.turso.io
TURSO_AUTH_TOKEN=

# ── Local dev only (OPTIONAL) ───────────────────────────────
# Leave this EMPTY on Render — only for local SQLite without Turso.
# Render's render.yaml already injects a dummy DATABASE_URL for the
# Prisma CLI during build; you don't need to set it in the dashboard.
DATABASE_URL=file:./db/custom.db

# ── JWT Secret (REQUIRED on Render) ────────────────────────
# Generate a strong random value with:
#   openssl rand -hex 32
JWT_SECRET=dev-only-insecure-secret-change-me

# ── JWT Expiry ─────────────────────────────────────────────
JWT_EXPIRES_IN=7d

# ── Backup passcode (REQUIRED on Render) ───────────────────
# Pick a strong string — used to gate DB download from admin UI.
ADMIN_BACKUP_PASSCODE=admin-passcode

# ── Default admin (used by `npm run seed`) ────────────────
ADMIN_NAME=د. أحمد الطبيب
ADMIN_PHONE=01000000000
ADMIN_PASSWORD=admin123

# ── Telegram (OPTIONAL — can be set later from the admin UI) ─
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERTS_CHAT_ID=

# ── Doctor WhatsApp number (for chat links) ────────────────
DOCTOR_WHATSAPP_NUMBER=201000000000

# ── Runtime ───────────────────────────────────────────────
NODE_ENV=development
