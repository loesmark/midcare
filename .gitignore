# ─────────────────────────────────────────────────────────────
*.db
*.db-journal
/prisma/dev.db
/prisma/db/
/db/

# ─────────────────────────────────────────────────────────────
#  Environment variables (NEVER commit secrets)
# ─────────────────────────────────────────────────────────────
.env
.env.local
.env.development
.env.production
.env*.local

# Keep .env.example as a template
!.env.example

# ─────────────────────────────────────────────────────────────
#  Logs
# ─────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev.log
dev.out.log
server.log

